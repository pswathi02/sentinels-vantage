# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — Claude Sonnet 4.6 for extraction, Q&A, memo synthesis
ANTHROPIC_API_KEY=sk-ant-...

# Bright Data — MCP server + direct API access
# Get from https://brightdata.com/cp/api_tokens
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_MCP_URL=https://mcp.brightdata.com

# Bright Data Web Unlocker zone — for blocked sources (Glassdoor, LinkedIn)
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# Bright Data SERP zone
BRIGHTDATA_SERP_ZONE=serp_api1

# Postgres (Vercel Postgres or Supabase recommended for pgvector)
DATABASE_URL=postgres://user:pass@host:5432/vantage

# Optional — voyage-3 or OpenAI for embeddings (for analog query feature)
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Demo mode — when "1", serves pre-cached results for the 3 demo targets
DEMO_MODE=1
